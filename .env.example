# 文本 LLM（用于转换结果排版优化）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 视觉模型 VLM（用于图片 alt 描述），可与文本 LLM 分离；不填则回退到上面的 LLM_*
# 例：本地 ollama
# VLM_API_KEY=ollama
# VLM_BASE_URL=http://192.168.31.165:11434/v1
# VLM_MODEL=qwen3.5:2b
# 识图并发数（默认 5）
VLM_MAX_CONCURRENCY=5

# MinerU 解析方法: auto(默认) / txt / ocr
# auto 由 MinerU 分类器自动判断（可识别扫描件/乱码字体）；需要强制时再设为 txt / ocr
# MINERU_METHOD=auto

# 常驻 mineru-api 工作进程池（复用已加载模型，免每次冷启动）。
# MINERU_WARM_POOL=1        # 0 关闭，回退为每次冷启动
# MINERU_MAX_CONCURRENCY=3  # 最大并发转换数（= worker 数）
# MINERU_API_PORT_BASE=51250
